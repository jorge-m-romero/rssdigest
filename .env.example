# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- Claude ---
# ONLY needed for the `run` command (API path, spends API credits).
# The recommended `run-local` command summarises via your local Claude Code
# subscription and needs NO key here.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional model override for the `run` (API) path:
# RSSDIGEST_MODEL=claude-haiku-4-5

# --- Feeds (comma-separated; omit to use the BleepingComputer default) ---
# RSS_FEEDS=https://www.bleepingcomputer.com/feed/,https://feeds.feedburner.com/TheHackersNews
# RSS_MAX_ITEMS=10

# --- Email (SMTP) ---
# The script SENDS via this SMTP account and the mail arrives in MAIL_TO's inbox.
# Sending from Gmail (as the original n8n flow did) is the easy path: Gmail still
# supports 16-char App Passwords. MAIL_TO can be any address you want the digest
# delivered to.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=you@gmail.com
# Gmail App Password (not your normal password). The same one you use in n8n works
# here too; or make a dedicated one at https://myaccount.google.com/apppasswords
SMTP_PASS=your-app-password
MAIL_FROM=you@gmail.com
MAIL_TO=recipient@gmail.com
# MAIL_SUBJECT=RSS Summary News

# --- State (only email items not seen before; recommended for cron) ---
# RSS_STATE=/home/kali/.cache/rssdigest/seen.txt
